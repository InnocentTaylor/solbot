# Required — your Solana wallet private key (base58 encoded)
# NEVER share this. Add it as a secret in the Railway dashboard.
SOLANA_PRIVATE_KEY=your_base58_private_key_here

# Automatically injected by Railway's PostgreSQL plugin — do not set manually
DATABASE_URL=postgresql://user:password@host:5432/dbname

# Optional — custom Solana RPC endpoint (recommended for production)
# Defaults to https://api.mainnet-beta.solana.com if not set.
# For better reliability and rate limits, use a dedicated provider:
#   Helius:   https://mainnet.helius-rpc.com/?api-key=YOUR_KEY
#   QuickNode: https://YOUR_ENDPOINT.quiknode.pro/YOUR_KEY/
RPC_ENDPOINT=https://api.mainnet-beta.solana.com

# Automatically set by Railway — do not set manually
PORT=8080

# Set via railway.toml [variables] — do not set manually
NODE_ENV=production
