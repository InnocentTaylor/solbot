# ── Required ──────────────────────────────────────────────────────────────────
# Your Solana wallet private key (base58 encoded).
# NEVER share this. Add it as a secret in Railway → Variables.
SOLANA_PRIVATE_KEY=your_private_key_here

# ── Recommended ───────────────────────────────────────────────────────────────
# Free Helius API key for a dedicated Solana RPC (avoids public rate limits).
# Sign up free at https://helius.dev — takes 2 minutes.
# If set, the bot automatically uses: https://mainnet.helius-rpc.com/?api-key=...
HELIUS_API_KEY=your_helius_api_key_here

# ── Optional ──────────────────────────────────────────────────────────────────
# Override the Solana RPC with any custom URL (takes priority over HELIUS_API_KEY).
# RPC_ENDPOINT=https://your-custom-rpc.com

# ── Auto-injected by Railway ── DO NOT set manually ───────────────────────────
# DATABASE_URL   — injected by Railway's PostgreSQL plugin
# PORT           — injected by Railway
# NODE_ENV       — set to "production" via railway.toml
