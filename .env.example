# Required — your Solana wallet private key (base58 encoded)
# NEVER share this. Add it as an environment variable in Railway dashboard.
SOLANA_PRIVATE_KEY=your_private_key_here

# Automatically injected by Railway's PostgreSQL plugin — do not set manually
DATABASE_URL=postgresql://user:password@host:5432/dbname

# Automatically set by Railway — do not set manually
PORT=8080

# Set automatically by railway.toml build command — do not set manually
NODE_ENV=production
